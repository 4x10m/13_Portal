# Server-specific runtime settings.  Copy to runtime.env (gitignored) and adapt.
#
# DATA_ROOT holds ALL persistent state (configs, databases, seeds).
# It must live OUTSIDE the repo: the staged compose trees (.runtime/) are
# disposable and re-created on every deploy.
DATA_ROOT=/opt/portal/data

# Timezone used across stacks
TZ=Europe/Paris
TIMEZONE=Europe/Paris

# Public / tailnet domain (documentaire — pas de reverse-proxy pour le dashboard)
DOMAIN=portal.axiiomlab.ovh

# Public IP du serveur
HOST_IP=51.68.39.122
