# Portal stack env. Copy to secrets/portal/stack.env and adapt (gitignored).
#
# Toutes les clés sont OPTIONNELLES : vides → le dashboard retombe sur ses
# valeurs par défaut (les routes codebase/opencode/cloud se dégradent
# proprement si les chemins n'existent pas dans le conteneur).

# Base de données du dashboard (chemin DANS le conteneur — montée depuis ${DATA_ROOT})
DATABASE_PATH=/app/data/dashboard.db

# DB opencode read-only (chemin dans le conteneur) — optionnel
OPENCODE_DB_PATH=

# Répertoire Codebase (chemin dans le conteneur) — optionnel
CODEBASE_DIR=

# Script cloud_manager.sh (chemin dans le conteneur) — optionnel
CLOUD_MANAGER_SCRIPT=

# API opencode dashboard (optionnel)
OPENCODE_API_URL=

# Tailscale (optionnel)
TAILNET=
TAILSCALE_API_KEY=
